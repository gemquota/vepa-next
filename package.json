{
  "name": "vepa-v4",
  "version": "9.1.2",
  "description": "VEPA4 — Vector Emergent Physics Automata (Integrated Intelligence release)",
  "type": "module",
  "scripts": {
    "concat": "node exports/generate-vepa-all.mjs",
    "generate:vepa-all": "node exports/generate-vepa-all.mjs",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:worker": "playwright test tests/e2e/physics-worker.spec.js",
    "spec:generate": "node scripts/generate-spec.mjs",
    "spec:check": "node scripts/generate-spec.mjs --check",
    "syntax-check": "find src -name '*.js' -exec node --check {} +"
  },
  "dependencies": {
    "pixi.js": "^8.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "vite": "^8.0.8",
    "vitest": "^3.2.7"
  }
}
